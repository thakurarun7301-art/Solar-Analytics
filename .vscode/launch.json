{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Solar App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py",
        "--server.headless",
        "true",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8501"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "You can now view your Streamlit app in your browser\\.",
        "uriFormat": "http://127.0.0.1:8501"
      }
    }
  ]
}
